# Secretos de las Edge Functions de Supabase (suscribir, confirmar, baja, resend-webhook,
# enviar-newsletter y adviento-correo). Nunca en el navegador ni en el repositorio.
# En producción se guardan con:  supabase secrets set --env-file <archivo>
# En local van en supabase/functions/.env.local (excluido de git).

# Supabase los pone solos en producción; no hace falta definirlos allí.
# SUPABASE_URL=https://zqautpepyjivwkzobfha.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Resend: clave de la API y secreto del webhook (whsec_…), de Resend › Webhooks
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Firma de los enlaces de confirmación y de descarga de guías (mínimo 32 caracteres aleatorios: openssl rand -hex 32)
ENLACES_SECRET=

# Secretos que comprueban las funciones lanzadas por pg_cron. El mismo valor va en Vault
# con los nombres newsletter_cron_secret y adviento_cron_secret.
NEWSLETTER_CRON_SECRET=
ADVIENTO_CRON_SECRET=

# Web pública, remitente y destinataria de las pruebas
SITE_URL=https://www.carla-lopez.com
CORREO_REMITENTE=Carla López <hola@carla-lopez.com>
PRUEBA_EMAIL=hola@carla-lopez.com

# Solo en local
# RESEND_DRY_RUN=1                              # no envía correos, los escribe en el registro
# URL_PUBLICA_SUPABASE=http://127.0.0.1:54321   # dirección de Storage que ve el navegador
