---
import '../styles/global.css';

interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = 'IA práctica para trabajar mejor, aunque no seas técnica.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1F5C8B" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body><slot /></body>
</html>
