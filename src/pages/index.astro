---
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import LegalFooter from '../components/LegalFooter.astro';
---
<Layout title="carlaylz · Entiende la IA" description="Tips, ideas y ejemplos reales para usar la IA en tu trabajo y en tu empresa, sin tecnicismos.">
  <main class="flex min-h-screen min-h-[100dvh] flex-col items-center justify-center bg-[radial-gradient(circle_at_10%_10%,rgba(243,201,105,.28),transparent_24rem),linear-gradient(135deg,#C0D9DF_0%,#DBE0CF_50%,#F6E2B3_100%)] px-4 py-12">
    <section class="w-full max-w-md text-center" aria-labelledby="newsletter-title">
      <img class="mx-auto mb-5 h-28 w-28 rounded-full border-4 border-white/70 object-cover shadow-lg shadow-petroleum/15" src="/assets/carla.png" alt="Carla" width="112" height="112" />
      <p class="mb-8 font-sans text-sm font-medium tracking-wide text-muted">@carlaylz</p>
      <h1 id="newsletter-title" class="mb-4 font-sans text-4xl font-black leading-tight tracking-tight text-petroleum sm:text-5xl">La IA <span class="bg-[linear-gradient(transparent_62%,#F3C969_62%)] px-0.5">no espera</span>.</h1>
      <p class="mb-8 text-[1.05rem] leading-relaxed text-muted">Hola, soy Carla 👋. Escribo un email cortito cada semana, con ideas de IA que puedas aplicar en tu vida profesional y personal.</p>
      <NewsletterForm source="home" />
    </section>
    <LegalFooter />
  </main>
</Layout>
