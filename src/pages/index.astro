---
import SiteLogo from '../components/SiteLogo.astro';
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import LegalFooter from '../components/LegalFooter.astro';
---
<Layout title="carlaylz · Entiende la IA" description="Tips, ideas y ejemplos reales para usar la IA en tu trabajo y en tu empresa, sin tecnicismos.">
  <header class="site-header mx-auto flex w-[min(1120px,calc(100%-32px))] items-center justify-between py-6 sm:w-[min(1120px,calc(100%-40px))]">
    <SiteLogo />
    <span class="hidden text-sm text-muted sm:block">IA práctica para trabajar mejor</span>
  </header>
  <main class="flex min-h-[calc(100dvh-5.5rem)] flex-col items-center justify-center bg-white px-4 py-12">
    <section class="w-full max-w-md text-center" aria-labelledby="newsletter-title">
      <img class="mx-auto mb-5 h-28 w-28 rounded-full border border-ink/10 object-cover" src="/assets/carla.png" alt="Carla" width="112" height="112" />
      <p class="mb-8 font-sans text-sm font-medium tracking-wide text-muted">@carlaylz</p>
      <h1 id="newsletter-title" class="site-hero-title mb-4 text-burgundy">La IA <span class="bg-[linear-gradient(transparent_62%,#F3C969_62%)] px-0.5">no espera</span>.</h1>
      <p class="mb-8 text-[1.05rem] leading-relaxed text-muted">Hola, soy Carla 👋. Escribo un email cortito cada semana, con ideas de IA que puedas aplicar en tu vida profesional y personal.</p>
      <NewsletterForm source="home" />
    </section>
    <LegalFooter />
  </main>
</Layout>
