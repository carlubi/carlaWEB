---
import SiteLogo from '../components/SiteLogo.astro';
import { CASILLA_AVISOS_ADVIENTO, CASILLA_NEWSLETTER_ADVIENTO, VERSION_POLITICA } from '../data/suscripciones';
import Layout from '../layouts/Layout.astro';
import days from '../data/adviento-meta.json';
import { dayIcon, iconHref } from '../data/adviento-icons';
import { doorClass } from '../data/adviento-tones';
import '../styles/adviento.css';
import '../styles/adviento-house.css';
const localPreview = import.meta.env.DEV;
const otpLength = 8;
---
<Layout title="Calendario de Adviento IA · carlaylz" description="Abre 24 pequeñas sorpresas para trabajar mejor con IA. Un nuevo reto cada día de diciembre.">
  <div class="advent-world" id="advent-app" data-version-politica={VERSION_POLITICA} data-days={JSON.stringify(days)} data-preview={localPreview ? 'true' : 'false'}>
    <div class="winter-glow" aria-hidden="true"></div>
    <canvas id="snow" class="snow" aria-hidden="true"></canvas>
    <header class="advent-topbar">
      <SiteLogo />
      <span class="topbar-year">Calendario de Adviento 2026</span>
      <button id="signout" class="quiet-button" type="button" hidden>Cerrar sesión</button>
    </header>
    <main class="advent-main">
      {localPreview && <div class="preview-banner" role="status"><span><strong>Vista local</strong> · Los 24 días están disponibles. Los avances de prueba se guardan solo en este navegador.</span><button id="preview-reset" type="button">Reiniciar avances</button></div>}
      <div class="preview-banner" id="admin-preview-banner" role="status" hidden><span><strong>Acceso anticipado</strong> · Puedes probar los 24 días en producción. Los avances se guardan en tu cuenta.</span></div>
      <div class="intro">
        <div><h1>Calendario de Adviento</h1><p>Un reto al día para descubrir nuevas formas de trabajar con IA.</p><span class="calendar-status-visually-hidden" id="calendar-status" role="status">El primer regalo llega el 1 de diciembre.</span></div>
        <div class="progress-cluster"><div class="progress-copy"><strong id="welcome-name">Tu calendario</strong><span id="progress-caption">Entra para guardar tus avances</span><ul class="progress-legend" id="progress-legend" hidden><li><i class="legend-key is-done" aria-hidden="true"></i><span id="legend-done"></span></li><li><i class="legend-key is-open" aria-hidden="true"></i><span id="legend-open"></span></li></ul></div><div class="progress-ring"><svg id="progress-ring" viewBox="0 0 96 96" role="img" aria-label="Progreso: 0 de 24 retos completados" shape-rendering="geometricPrecision"></svg><div class="ring-center" aria-hidden="true"><strong id="completed-count">0</strong><span>de 24</span></div></div></div>
      </div>
      <div class="calendar-waiting" id="calendar-waiting" role="status" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href={iconHref('calendar-link')} /></svg>
        <p><strong>El calendario aún no se puede abrir.</strong> Vuelve el <time datetime="2026-12-01">1 de diciembre de 2026</time> para descubrir el primer reto.</p>
      </div>
      <section class="calendar-stage is-locked" id="calendar-stage" aria-label="Calendario de Adviento">
          <div class="house-scene" id="calendar-board" inert>
            <div class="house-ground" aria-hidden="true"></div>
            <div class="house-pine house-pine-left" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="house-pine house-pine-right" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="house-object" id="house-object">
              <div class="house-chimney" aria-hidden="true"></div>
              <div class="house-roof-plane" aria-hidden="true"></div>
              <div class="house-roof" aria-hidden="true">
                <svg class="roof-icing" viewBox="0 0 1000 250" preserveAspectRatio="none"><path d="M15 204 500 17 985 204"/><path d="M18 221Q45 235 72 221T126 221T180 221T234 221T288 221T342 221T396 221T450 221T504 221T558 221T612 221T666 221T720 221T774 221T828 221T882 221T936 221T990 221"/></svg>
                <div class="roof-insignia"><svg class="roof-star" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 2 58 37 86 14 63 42 98 50 63 58 86 86 58 63 50 98 42 63 14 86 37 58 2 50 37 42 14 14 42 37Z"/></svg><span>24 pequeñas sorpresas</span><span class="roof-year">DICIEMBRE · 2026</span></div>
              </div>
              <div class="house-side" aria-hidden="true"></div>
              <div class="house-body">
                <div class="house-eave" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span></div>
                <div class="calendar-grid" id="door-grid" aria-label="Cajones del calendario">
                  {days.map((day, i) => <button class={`${doorClass(day.dia, day.tipo, i)} future`} type="button" disabled aria-label={`Día ${day.dia}, cerrado`}><span class="door-content"><span class="door-prize" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href={iconHref(dayIcon(day.dia))} /></svg></span><span class="door-title">{day.titulo}</span></span><span class="drawer-sleeve"><span class="drawer-side" aria-hidden="true"></span><span class="drawer-bottom" aria-hidden="true"></span><span class="door-front"><span class="drawer-notch" aria-hidden="true"></span><span class="door-number">{String(day.dia).padStart(2,'0')}</span><svg class="door-illustration" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={iconHref(dayIcon(day.dia))} /></svg><span class="door-flake" aria-hidden="true">✳</span></span></span><span class="door-stamp" aria-hidden="true">✓</span></button>)}
                </div>
                <div class="house-plinth" aria-hidden="true"><span>Un pequeño descubrimiento cada día</span><span>✦</span></div>
              </div>
            </div>
          </div>
        <div class="access-gate" id="access-gate">
          <div class="access-card" id="access-card" role="dialog" aria-modal="false" aria-labelledby="access-title" aria-describedby="access-description">
            <div class="access-steps" aria-hidden="true"><span class="is-current"></span><span></span><span></span></div>
            <p class="access-step" id="access-eyebrow">Paso 1 de 3 · Tu correo</p>
            <h2 id="access-title">Tu diciembre empieza aquí</h2>
            <p class="access-description" id="access-description">24 retos para aprender IA, uno al día. Entra con tu correo y guardamos tus avances.</p>
            <form id="email-form" novalidate><label for="email">Correo electrónico</label><input id="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="tu@correo.com" required aria-describedby="email-help" /><button class="main-button" type="submit"><span class="button-label">Recibir mi código</span></button><p class="form-help" id="email-help">Te mandamos un código de {otpLength} cifras. Sin contraseñas.</p></form>
            <div id="verify-step" hidden>
              <form id="code-form" novalidate>
                <label for="code">Código de {otpLength} cifras</label>
                <div class="code-field" id="code-field">
                  <input id="code" class="code-input" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength={otpLength} aria-describedby="code-help" />
                  <div class="code-cells" style={`--otp-length: ${otpLength}`} aria-hidden="true">{Array.from({ length: otpLength }, () => <span></span>)}</div>
                </div>
                <button class="main-button" type="submit"><span class="button-label">Entrar al calendario</span></button>
              </form>
              <p class="form-help" id="code-help">¿No te llega? Mira en spam o en promociones. El código caduca en una hora.</p>
              <button id="resend-code" class="link-button" type="button">Reenviar código</button>
            </div>
            <form id="register-form" novalidate hidden><label for="name">Tu nombre</label><input id="name" type="text" autocomplete="given-name" maxlength="80" placeholder="¿Cómo te llamas?" required /><label class="check-line" for="privacy-check"><input id="privacy-check" type="checkbox" /><span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</span></label><label class="check-line" for="mail-check"><input id="mail-check" type="checkbox" /><span>{CASILLA_AVISOS_ADVIENTO} <em>Opcional.</em></span></label><label class="check-line" for="newsletter-check"><input id="newsletter-check" type="checkbox" /><span>{CASILLA_NEWSLETTER_ADVIENTO} <em>Opcional.</em></span></label><button class="main-button" id="register-button" type="submit" disabled><span class="button-label">Crear mi calendario</span></button></form>
            <p class="form-message" id="auth-message" role="alert" aria-live="polite"></p>
          </div>
        </div>
      </section>
      <p id="calendar-hint" class="calendar-hint">Los retos empiezan el 1 de diciembre. Puedes reservar tu sitio desde hoy.</p>
      <section class="achievements" id="achievements" aria-labelledby="achievements-title" hidden>
        <div class="achievements-heading"><h2 id="achievements-title">Logros</h2><p id="achievement-status">Se consiguen según avanzas.</p></div>
        <div class="achievement-grid" id="achievement-grid"></div>
        <div class="achievement-reward">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href={iconHref('gift')} /></svg>
          <p><strong>Completa los 24 días y tendrás un regalo.</strong> Anunciaré cuál será más adelante.</p>
        </div>
      </section>
    </main>
    <noscript><style>.house-scene:not(.is-3d){padding:76px clamp(28px,8vw,100px) 72px;min-height:400px;aspect-ratio:auto;perspective:1350px}.house-scene:not(.is-3d)>*{visibility:visible}.house-scene:not(.is-3d) .house-object{position:relative;inset:auto;overflow:visible}</style></noscript>
    <footer class="advent-footer"><span>Un reto nuevo cada día</span><div><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></div></footer>
    <dialog id="caganer-dialog" class="gift-dialog caganer-dialog" aria-labelledby="caganer-title" aria-describedby="caganer-lead">
      <div class="caganer-hero" aria-hidden="true">
        <span class="caganer-spark s1">✦</span><span class="caganer-spark s2">✧</span><span class="caganer-spark s3">✦</span>
        <img id="caganer-portrait" class="caganer-portrait" alt="" width="180" height="180" hidden />
        <svg id="caganer-fallback" class="caganer-fallback" viewBox="0 0 24 24"><use href={iconHref('gift')} /></svg>
        <span class="caganer-ground"></span>
      </div>
      <button class="gift-close" id="caganer-close" type="button" aria-label="Cerrar"><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      <div class="caganer-body">
        <h2 id="caganer-title">¡Has encontrado al caganer!</h2>
        <p class="caganer-lead" id="caganer-lead">La figura escondida del belén catalán: un payés con barretina roja haciendo sus necesidades en un rincón.</p>
        <p class="caganer-achievement-status" id="caganer-achievement-status" role="status" aria-live="polite"></p>
        <ul class="caganer-facts">
          <li><strong>Trae suerte.</strong> Abona la tierra: simboliza la fertilidad y un buen año.</li>
          <li><strong>Nos iguala.</strong> Recuerda que todos, sin excepción, somos iguales.</li>
          <li><strong>Hay que buscarlo.</strong> La tradición es encontrarlo cada Navidad, como acabas de hacer.</li>
        </ul>
        <div class="caganer-ai">
          <span class="caganer-ai-label">Hecho con IA</span>
          <p>Esta casa en 3D, el caganer y hasta la nube de humo salen de un prompt a Claude (Opus 5.5, esfuerzo alto).</p>
        </div>
        <button class="main-button" id="caganer-ok" type="button">Seguir con el calendario</button>
      </div>
    </dialog>
    <dialog id="gift-dialog" class="gift-dialog day-dialog" aria-labelledby="gift-title" aria-describedby="gift-description"><button class="gift-close" id="gift-close" type="button" aria-label="Cerrar"><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button><div class="day-badge" aria-hidden="true"><span class="day-badge-halo"></span><span class="day-badge-icon"><svg viewBox="0 0 24 24" focusable="false"><use id="gift-icon-use" href={iconHref('gift')} /></svg></span><span class="sparkle s1">✦</span><span class="sparkle s2">✧</span><span class="sparkle s3">✦</span></div><p class="gift-day" id="gift-day"></p><h2 id="gift-title"></h2><p class="gift-description" id="gift-description"></p><ul class="gift-meta" aria-label="Detalles del día"><li id="gift-tool"></li><li id="gift-time"></li></ul><a id="gift-link" class="main-button" href="/adviento"><span id="gift-cta">Empezar el reto</span> <span aria-hidden="true">→</span></a><button id="gift-later" class="gift-later" type="button">Más tarde</button><p class="gift-note">El día queda abierto en tu calendario. Puedes volver cuando quieras.</p></dialog>
  </div>
</Layout>
<script src="../scripts/adviento.ts"></script>
