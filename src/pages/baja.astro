---
/*
 * Baja en un clic, sin login. /baja?token=…&lista=adviento|newsletter (correos nuevos)
 * y /baja?id=… (correos antiguos de la newsletter). Abrir la página no da de baja: hace falta pulsar el botón.
 */
import Layout from '../layouts/Layout.astro';
import LegalFooter from '../components/LegalFooter.astro';
import SiteLogo from '../components/SiteLogo.astro';
import { API_BASE } from '../data/suscripciones';
---
<Layout title="Darse de baja · carla lópez" noindex>
  <header class="site-header mx-auto flex w-[min(1120px,calc(100%-32px))] items-center py-6 sm:w-[min(1120px,calc(100%-40px))]">
    <SiteLogo />
  </header>
  <main class="mx-auto flex min-h-[70dvh] w-[min(520px,calc(100%-32px))] flex-col justify-center py-12" data-api={API_BASE}>
    <section id="pedir" class="site-card p-6 sm:p-8" hidden>
      <h1 id="titulo" class="mb-3 font-sans text-[28px] font-semibold leading-tight text-burgundy">¿Quieres darte de baja?</h1>
      <p id="explicacion" class="mb-6 leading-relaxed text-muted"></p>
      <button id="boton-baja" class="site-button min-h-12 w-full" type="button">Darme de baja</button>
      <button id="boton-todo" class="mt-3 min-h-12 w-full rounded-lg border border-burgundy/30 bg-white px-6 font-semibold text-burgundy hover:bg-[#fbf4f5]" type="button">Darme de baja de todo</button>
      <a class="mt-4 block text-center text-sm font-semibold text-muted hover:text-burgundy hover:underline" href="/">No, quiero seguir</a>
    </section>
    <section id="hecho" class="site-card p-6 sm:p-8" hidden tabindex="-1">
      <h2 class="mb-3 font-sans text-[28px] font-semibold leading-tight text-burgundy">Ya está</h2>
      <p id="hecho-texto" class="mb-6 leading-relaxed text-muted"></p>
      <button id="boton-deshacer" class="min-h-12 w-full rounded-lg border border-burgundy/30 bg-white px-6 font-semibold text-burgundy hover:bg-[#fbf4f5]" type="button" hidden>Me he equivocado, volver a suscribirme</button>
      <a class="mt-4 block text-center text-sm font-semibold text-burgundy hover:underline" href="/">Volver al inicio</a>
    </section>
    <section id="invalido" class="site-card p-6 sm:p-8" hidden>
      <h1 class="mb-3 font-sans text-[28px] font-semibold leading-tight text-burgundy">Este enlace no es válido</h1>
      <p class="leading-relaxed text-muted">Usa el enlace «Darme de baja» que aparece al final de cualquiera de mis correos.</p>
    </section>
    <p id="mensaje" class="min-h-6 pt-3 text-center text-sm text-[#b3261e]" role="alert" aria-live="polite"></p>
  </main>
  <LegalFooter />
  <script>
    const LISTS = {
      adviento: { name: 'los avisos del calendario de Adviento', what: 'Dejarás de recibir el aviso de cada día. Tu calendario y tus avances siguen disponibles.' },
      newsletter: { name: 'la newsletter semanal', what: 'Dejarás de recibir la newsletter de los domingos.' }
    } as const;
    type List = keyof typeof LISTS | 'todo';
    const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    const $ = (id:string) => document.getElementById(id) as HTMLElement;
    const api = (document.querySelector('main') as HTMLElement).dataset.api;
    const params = new URLSearchParams(location.search);
    const token = params.get('token') || '';
    const legacyId = params.get('id') || '';
    const list = (params.get('lista') || 'newsletter') as keyof typeof LISTS;
    /* el token no se queda a la vista en la barra de direcciones ni en el historial */
    history.replaceState(null, '', location.pathname);
    let last:List = list;

    const fail = (text:string) => { $('mensaje').textContent = text; };
    const busy = (button:HTMLButtonElement, text:string|null, original:string) => { button.disabled = Boolean(text); button.textContent = text || original; };

    async function call(body:Record<string, string>) {
      const response = await fetch(`${api}/baja`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'No se ha podido procesar. Inténtalo de nuevo en unos minutos.');
    }
    async function legacy() {
      /* enlaces antiguos de la newsletter: /baja?id=… */
      const response = await fetch('https://zqautpepyjivwkzobfha.supabase.co/rest/v1/rpc/darse_de_baja', { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: 'sb_publishable_Ly0aaOm_Ef50mPeui_ke4w_0Y5sxcv7' }, body: JSON.stringify({ p_id: legacyId }) });
      if (!response.ok) throw new Error('No se ha podido procesar. Inténtalo de nuevo en unos minutos.');
    }
    function done(which:List, canUndo:boolean) {
      last = which;
      $('pedir').hidden = true; $('mensaje').textContent = '';
      $('hecho-texto').textContent = which === 'todo'
        ? 'No recibirás ningún correo más: ni los avisos del calendario ni la newsletter.'
        : `Te has dado de baja de ${LISTS[which].name}. ${LISTS[which].what}`;
      ($('boton-deshacer') as HTMLButtonElement).hidden = !canUndo;
      $('hecho').hidden = false; $('hecho').focus();
    }

    const validNew = UUID.test(token) && list in LISTS;
    if (!validNew && !UUID.test(legacyId)) {
      $('invalido').hidden = false;
    } else {
      $('explicacion').textContent = `Vas a darte de baja de ${LISTS[list].name}. ${LISTS[list].what}`;
      ($('boton-todo') as HTMLButtonElement).hidden = !validNew;
      $('pedir').hidden = false;
    }

    const one = $('boton-baja') as HTMLButtonElement, all = $('boton-todo') as HTMLButtonElement, undo = $('boton-deshacer') as HTMLButtonElement;
    one.addEventListener('click', async () => {
      busy(one, 'Procesando…', 'Darme de baja');
      try { if (validNew) await call({ token, lista: list }); else await legacy(); done(list, validNew); }
      catch (error) { fail((error as Error).message); busy(one, null, 'Darme de baja'); }
    });
    all.addEventListener('click', async () => {
      busy(all, 'Procesando…', 'Darme de baja de todo');
      try { await call({ token, lista: 'todo' }); done('todo', true); }
      catch (error) { fail((error as Error).message); busy(all, null, 'Darme de baja de todo'); }
    });
    undo.addEventListener('click', async () => {
      busy(undo, 'Procesando…', 'Me he equivocado, volver a suscribirme');
      try {
        await call({ token, lista: last, accion: 'deshacer' });
        undo.hidden = true;
        $('hecho-texto').textContent = 'Listo, mantienes tu suscripción como antes.';
      } catch (error) { fail((error as Error).message); busy(undo, null, 'Me he equivocado, volver a suscribirme'); }
    });
  </script>
</Layout>
