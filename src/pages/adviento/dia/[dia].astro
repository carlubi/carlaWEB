---
import Layout from '../../../layouts/Layout.astro';
import days from '../../../data/adviento-meta.json';
import { iconHref } from '../../../data/adviento-icons';
import '../../../styles/adviento.css';
import '../../../styles/adviento-day.css';
import { readFileSync } from 'node:fs';
export function getStaticPaths() {
  return days.map(day => ({ params: { dia: String(day.dia) }, props: { day } }));
}
const { day } = Astro.props;
const localPreview = import.meta.env.DEV;
const previewContent = localPreview
  ? JSON.parse(readFileSync('src/data/adviento-preview.json','utf8')).find((item: { dia:number }) => item.dia === day.dia)?.contenido
  : null;
const number = String(day.dia).padStart(2,'0');
---
<Layout title={`Día ${day.dia}: ${day.titulo} · Adviento IA`} description={day.descripcion} noindex>
  <div class="advent-world challenge-page" id="day-app" data-day={day.dia} data-summary={day.descripcion} data-needs={day.datos} data-preview={localPreview ? 'true' : 'false'} data-preview-content={localPreview ? JSON.stringify(previewContent) : undefined}>
    <header class="advent-topbar">
      <a class="font-sans text-xl font-semibold tracking-[-.03em] text-burgundy hover:underline" href="/" aria-label="carla lópez, ir al inicio">carla lópez</a>
      <span class="topbar-year">Calendario de Adviento 2026</span>
    </header>
    <main class="challenge-main">
      <a class="back-link" href="/adviento"><svg aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('arrow-left')} /></svg>Volver al calendario</a>
      {localPreview && <div class="preview-banner day-preview-banner" role="status"><span><strong>Vista local</strong> · Contenido completo del día {day.dia}. La apertura y el progreso son de prueba.</span></div>}
      {localPreview && <section class="local-editor" id="local-editor" aria-labelledby="local-editor-title">
        <div class="local-editor-heading"><div><h2 id="local-editor-title">Editar este día</h2><p>Se guarda en el proyecto. Al publicar, actualiza también el contenido de Supabase con el SQL generado.</p></div><button type="button" id="editor-toggle" aria-expanded="false" aria-controls="editor-panel">Abrir editor</button></div>
        <div id="editor-panel" hidden>
          <form id="editor-form">
            <div class="editor-fields">
              <label>Título<input name="titulo" required /></label>
              <label>Tipo<input name="tipo" required /></label>
              <label>Herramienta<input name="herramienta" required /></label>
              <label>Minutos<input name="minutos" type="number" min="1" max="999" required /></label>
              <label class="editor-wide">Descripción breve<textarea name="descripcion" rows="3" required></textarea></label>
              <label class="editor-wide">Lo que necesitas<input name="datos" required /></label>
            </div>
            <label class="editor-body-label" for="editor-body">Contenido del día</label>
            <p class="editor-help">Usa «##» para una sección, «###» para un paso, «## Prompt · Nombre» para un prompt y «## Descarga · Nombre» para un documento. El texto admite Markdown.</p>
            <textarea id="editor-body" name="cuerpo" rows="20" spellcheck="true" required></textarea>
            <div class="editor-uploads"><button type="button" id="editor-image">Añadir imagen</button><button type="button" id="editor-document">Añadir documento</button><input id="editor-file" type="file" hidden /></div>
            <div class="editor-actions"><button type="submit" id="editor-save">Guardar cambios</button><span id="editor-status" role="status" aria-live="polite"></span></div>
          </form>
        </div>
      </section>}
      <div id="challenge-loading" class="challenge-loading" role="status" aria-live="polite"><span class="loading-star" aria-hidden="true">✦</span><p>Preparando tu regalo…</p></div>
      <div id="challenge-error" class="challenge-error" hidden><h1>Esta puerta sigue cerrada.</h1><p id="challenge-error-text">Vuelve al calendario para abrirla cuando llegue su día.</p><a class="main-button" href="/adviento">Ir al calendario <span aria-hidden="true">↗</span></a></div>

      <article id="challenge-content" class="challenge" hidden>
        <header class="day-header">
          <div class="day-badge" id="day-badge">
            <span class="day-badge-number" aria-hidden="true">{number}</span>
            <span class="day-badge-type">{day.tipo}</span>
            <span class="day-badge-stamp" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6.5 12.5 3.5 3.5 7.5-8"/></svg></span>
          </div>
          <div class="day-heading">
            <h1 id="challenge-title"><span class="sr-only">Día {day.dia}: </span>{day.titulo}</h1>
            <ul class="day-meta" aria-label="Detalles del reto">
              <li><svg aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('mini-app')} /></svg><span class="sr-only">Herramienta: </span>{day.herramienta}</li>
              <li><svg aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('timer')} /></svg><span class="sr-only">Tiempo: </span>{day.minutos} min</li>
            </ul>
          </div>
          <div class="day-complete">
            <button class="complete-button" type="button" data-complete>
              <span class="complete-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16.2 9.5"/></svg><i></i><i></i><i></i><i></i><i></i><i></i></span>
              <span class="complete-label">Marcar como completado</span>
            </button>
            <p class="complete-status" data-complete-status role="status" aria-live="polite"></p>
          </div>
        </header>

        <section class="deck" id="deck" aria-roledescription="presentación" aria-label="Explicación del reto">
          <div class="deck-bar">
            <button class="deck-index" id="deck-index" type="button"><svg aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('list')} /></svg>Índice</button>
            <div class="deck-progress" id="deck-progress" aria-hidden="true"></div>
            <p class="deck-count" id="deck-count" aria-hidden="true"></p>
          </div>
          <div class="deck-viewport" id="deck-viewport"></div>
          <nav class="deck-nav" aria-label="Pasar diapositivas">
            <button class="deck-button deck-prev" id="deck-prev" type="button" aria-label="Diapositiva anterior"><svg aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('arrow-left')} /></svg><span>Anterior</span></button>
            <button class="deck-button deck-next" id="deck-next" type="button"><span class="deck-next-text"><small>Siguiente</small><span id="deck-next-title"></span></span><svg id="deck-next-icon" aria-hidden="true" viewBox="0 0 24 24"><use href={iconHref('arrow-right')} /></svg></button>
          </nav>
          <p class="sr-only" id="deck-status" aria-live="polite"></p>
        </section>

        <div class="resources" id="resources">
          <section id="challenge-prompts" class="resource-block resource-prompts" aria-labelledby="prompts-title" tabindex="-1" hidden>
            <div class="resource-heading"><h2 id="prompts-title">Prompts para copiar</h2><p>Pégalos en Claude y cambia lo que va entre corchetes por lo tuyo.</p></div>
            <div class="prompt-list" id="prompt-list"></div>
          </section>
          <aside id="challenge-downloads" class="resource-block resource-downloads" aria-labelledby="downloads-title" tabindex="-1" hidden>
            <div class="resource-heading"><h2 id="downloads-title">Para descargar</h2><p>Plantillas, chuletas y datos de prueba de este reto.</p></div>
            <ul class="download-list" id="download-list"></ul>
          </aside>
        </div>

        <section class="finish" aria-labelledby="finish-title">
          <div>
            <h2 id="finish-title">¿Has terminado el reto?</h2>
            <p>Márcalo y se guarda en tu calendario.</p>
          </div>
          <div class="day-complete">
            <button class="complete-button" type="button" data-complete>
              <span class="complete-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16.2 9.5"/></svg><i></i><i></i><i></i><i></i><i></i><i></i></span>
              <span class="complete-label">Marcar como completado</span>
            </button>
            <p class="complete-status" data-complete-status></p>
          </div>
        </section>
      </article>
    </main>
    <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
    <footer class="advent-footer"><span>Una idea nueva cada día. A tu manera.</span><div><a href="/adviento">Calendario</a><a href="/privacidad">Privacidad</a></div></footer>
  </div>
</Layout>
<script src="../../../scripts/adviento-day.ts"></script>
