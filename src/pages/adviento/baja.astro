---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Baja de avisos de Adviento · carlaylz" noindex>
  <main class="mx-auto flex min-h-[80dvh] max-w-xl flex-col justify-center px-5 py-12 text-ink">
    <a href="/adviento" class="mb-8 text-sm font-semibold text-burgundy hover:underline">← Volver al calendario</a>
    <section class="site-card p-7 sm:p-10" aria-labelledby="title">
      <h1 id="title" class="mb-3 font-brand text-3xl font-semibold text-burgundy">Avisos del calendario</h1>
      <p class="mb-6 leading-relaxed text-muted">Puedes dejar de recibir los correos diarios. Tu calendario y tus avances seguirán disponibles.</p>
      <button id="unsubscribe" type="button" class="site-button min-h-12">Dar de baja los avisos diarios</button>
      <p id="result" role="status" aria-live="polite" class="mt-5 text-sm text-muted"></p>
    </section>
  </main>
  <script>
    const button=document.getElementById('unsubscribe') as HTMLButtonElement;
    const result=document.getElementById('result')!;
    const token=new URLSearchParams(location.search).get('token');
    history.replaceState(null,'',location.pathname);
    if(!token||!/^[0-9a-f-]{36}$/i.test(token)){button.disabled=true;result.textContent='Este enlace no es válido. Abre el enlace que aparece en tu correo.';}
    button.addEventListener('click',async()=>{
      button.disabled=true;result.textContent='Procesando la baja…';
      try{
        const response=await fetch('https://zqautpepyjivwkzobfha.supabase.co/rest/v1/rpc/adviento_darse_de_baja',{method:'POST',headers:{apikey:'sb_publishable_Ly0aaOm_Ef50mPeui_ke4w_0Y5sxcv7','Content-Type':'application/json'},body:JSON.stringify({p_token:token})});
        if(!response.ok)throw new Error('Error de red');
        const done=await response.json();
        result.textContent=done?'Ya no recibirás los avisos diarios del calendario.':'No hemos encontrado esta suscripción. Comprueba el enlace de tu correo.';
      }catch{result.textContent='No hemos podido procesar la baja. Inténtalo de nuevo en unos minutos.';button.disabled=false;}
    });
  </script>
</Layout>
